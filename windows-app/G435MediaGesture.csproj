<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- The Windows 10 SDK projection gives Windows.Media.Control (the media session manager). -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Application.SetColorMode (light/dark) is still marked experimental. -->
    <NoWarn>$(NoWarn);WFO5001</NoWarn>
    <AssemblyName>G435MediaGesture</AssemblyName>
    <ApplicationIcon>..\assets\icon\g435.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <!-- Embedded too, so the tray can load the 16px frame instead of downscaling the 32px exe icon. -->
    <EmbeddedResource Include="..\assets\icon\g435.ico" LogicalName="g435.ico" />
  </ItemGroup>

</Project>
